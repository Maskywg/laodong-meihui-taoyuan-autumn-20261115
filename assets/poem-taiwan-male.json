[
  {
    "start": 0.0,
    "end": 3.85,
    "text": "水岸秋初楓葉紅，"
  },
  {
    "start": 4.25,
    "end": 6.95,
    "text": "大溪佳節醉清風；"
  },
  {
    "start": 7.75,
    "end": 11.0,
    "text": "千重錦繡鋪花海，"
  },
  {
    "start": 11.4,
    "end": 13.911,
    "text": "落雨松頭入碧空；"
  },
  {
    "start": 14.711,
    "end": 19.211,
    "text": "雲淡事輕心自遠，"
  },
  {
    "start": 19.611,
    "end": 23.111,
    "text": "暫別塵囂意無窮；"
  },
  {
    "start": 23.911,
    "end": 26.511,
    "text": "悠然不羨桃源境，"
  },
  {
    "start": 26.911,
    "end": 29.498,
    "text": "且攜老伴作閒翁！"
  }
]